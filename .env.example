# Local Supabase — values printed by `pnpm db:start` / `pnpm supabase status`.
# The frontend must ONLY ever see the anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Node-only. NEVER prefix with VITE_, never import under src/.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Hosted build only (Vercel). A static bundle has no Vault API, so the startup
# picker offers Campus Cloud only. Leave unset for local development.
# VITE_CAMPUS_VAULT=off

# Tester tooling (/dev one-click login, published password). Local only: it is
# ignored whenever VITE_CAMPUS_VAULT=off. NEVER set it in the hosting dashboard.
# VITE_CAMPUS_TESTER=1
