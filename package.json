{
  "name": "campus-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/with-supabase-env.mjs ./node_modules/.bin/vitest run --config vitest.db.config.ts",
    "test:full": "pnpm test && pnpm test:db",
    "db:start": "./node_modules/.bin/supabase start",
    "db:stop": "./node_modules/.bin/supabase stop",
    "db:reset": "./node_modules/.bin/supabase db reset",
    "db:types": "./node_modules/.bin/supabase gen types typescript --local > src/lib/db/database.types.ts",
    "seed:generate": "node scripts/generate-seed.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "verify:journey": "node scripts/verify-journey.mjs",
    "verify": "pnpm verify:journey && pnpm verify:ui && pnpm verify:a11y",
    "tester": "node scripts/tester.mjs",
    "verify:frontend": "node scripts/verify-frontend.mjs",
    "verify:local": "node scripts/verify-local-journey.mjs",
    "verify:a11": "node scripts/verify-a11-journey.mjs",
    "verify:unr": "node scripts/verify-unr-unknown.mjs",
    "verify:local-frontend": "node scripts/verify-local-frontend.mjs",
    "verify:bind": "node scripts/verify-vault-bind.mjs",
    "verify:frontend:xvfb": "xvfb-run -n 99 -s \"-screen 0 1600x1200x24 -nolisten tcp\" env CAMPUS_HEADED=1 node scripts/verify-frontend.mjs",
    "dev:tailnet": "node scripts/dev-tailnet.mjs",
    "catalog:generate": "node scripts/generate-catalog.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/router-plugin": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supabase": "^2.48.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
