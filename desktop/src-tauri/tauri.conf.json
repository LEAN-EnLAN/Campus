{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campus",
  "mainBinaryName": "Campus",
  "version": "0.1.0",
  "identifier": "ar.campus.desktop",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Campus",
    "category": "Education",
    "shortDescription": "Campus — tu carrera y tus apuntes, en tu propia carpeta",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
